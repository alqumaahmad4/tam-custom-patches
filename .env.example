# Public site
NEXT_PUBLIC_SITE_URL=https://tamcustompatches.com

# Cloudflare Turnstile
NEXT_PUBLIC_TURNSTILE_SITE_KEY=your_turnstile_site_key
TURNSTILE_SECRET_KEY=your_turnstile_secret_key

# Cloudflare R2
CLOUDFLARE_R2_ACCOUNT_ID=your_cloudflare_account_id
CLOUDFLARE_R2_ACCESS_KEY_ID=your_r2_access_key_id
CLOUDFLARE_R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
CLOUDFLARE_R2_BUCKET_NAME=tam-uploads
CLOUDFLARE_R2_PUBLIC_URL=https://assets.tamcustompatches.com

# Transactional email
RESEND_API_KEY=your_resend_api_key
RESEND_FROM_EMAIL=noreply@tamcustompatches.com
RESEND_INTERNAL_EMAIL=quotes@tamcustompatches.com

# Revalidation
REVALIDATE_SECRET=replace_with_random_secret

# Rate limiting
UPSTASH_REDIS_REST_URL=https://example.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_token

# Analytics
NEXT_PUBLIC_GTM_ID=GTM-XXXXXXX
NEXT_PUBLIC_GA4_ID=G-XXXXXXXXXX

# Phase 2 placeholders
NEXTAUTH_SECRET=
NEXTAUTH_URL=
DATABASE_URL=
SANITY_PROJECT_ID=
SANITY_DATASET=
SANITY_API_TOKEN=
STABILITY_AI_API_KEY=
ADMIN_ALLOWED_IPS=
